+        a.put(def("play_song","Start a song on PC Spotify. Accept a search query or Spotify track URI/link. Requires connected companion and Spotify extension. Never say playback succeeded if this tool returns an error.",new JSONObject().put("query",field("string","Song search query or exact Spotify track URI/link")),"query"));
