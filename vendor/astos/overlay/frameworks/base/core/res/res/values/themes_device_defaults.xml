<?xml version="1.0" encoding="utf-8"?>
<!--
  AstOs power options (long-press power): warm espresso dialog.

  The v2.3 power menu inherited the Material dialog window background, which
  resolves to WHITE on this device — cream monospace text on white was
  unreadable. These overlay entries replace both DeviceDefault alert themes
  (dark + light — whichever the system context resolves) with the same items
  they define upstream (LineageOS 14.1 themes_device_defaults.xml: parent +
  windowTitleStyle + colorPrimary/PrimaryDark/Accent) PLUS a warm espresso
  windowBackground, terracotta accent and a matching divider.

  Parents and base items mirror upstream exactly, so nothing else in the
  theme chain is lost when the overlay entry replaces the base entry.
-->
<resources>

    <style name="Theme.DeviceDefault.Dialog.Alert" parent="@*android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowTitleStyle">@*android:style/DialogWindowTitle.DeviceDefault</item>

        <!-- Color palette (upstream dark values) -->
        <item name="android:colorPrimary">@*android:color/primary_device_default_dark</item>
        <item name="android:colorPrimaryDark">@*android:color/primary_dark_device_default_dark</item>
        <item name="android:colorAccent">@*android:color/accent_device_default_dark</item>

        <!-- AstOs: warm espresso card, terracotta accent -->
        <item name="android:windowBackground">@drawable/ast_power_bg</item>
        <item name="android:colorControlActivated">#FFC96F4A</item>
        <item name="android:listDivider">@drawable/ast_divider_warm</item>
    </style>

    <style name="Theme.DeviceDefault.Light.Dialog.Alert" parent="@*android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowTitleStyle">@*android:style/DialogWindowTitle.DeviceDefault.Light</item>

        <!-- Color palette (upstream light values) -->
        <item name="android:colorPrimary">@*android:color/primary_device_default_light</item>
        <item name="android:colorPrimaryDark">@*android:color/primary_dark_device_default_light</item>
        <item name="android:colorAccent">@*android:color/accent_device_default_light</item>

        <!-- AstOs: SAME warm espresso card — no white dialogs anywhere -->
        <item name="android:windowBackground">@drawable/ast_power_bg</item>
        <item name="android:colorControlActivated">#FFC96F4A</item>
        <item name="android:listDivider">@drawable/ast_divider_warm</item>
    </style>

</resources>
