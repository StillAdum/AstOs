<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AstOs volume dialog: warm espresso panel, terracotta slider tint,
         chunky monospace header. Same parent as upstream to keep everything
         else intact; colorPrimary drives volume_dialog_background (?android:
         colorPrimary shape) and Utils.getColorAccent() drives the sliders. -->
    <style name="systemui_theme" parent="@*android:style/Theme.DeviceDefault.Settings.Dark">
        <item name="android:colorPrimary">#FF2A211B</item>
        <item name="android:colorAccent">#FFC96F4A</item>
        <item name="android:colorControlActivated">#FFC96F4A</item>
    </style>

    <style name="TextAppearance.Volume.Header">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#FFF2E7DA</item>
    </style>
</resources>
