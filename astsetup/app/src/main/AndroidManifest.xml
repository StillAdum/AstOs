<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- the AstSetup_xxxx hotspot: platform-signed privileged build gets
         tether control (granted by signature inside the ROM) -->
    <uses-permission android:name="android.permission.TETHER_PRIVILEGED"/>
    <!-- the wizard saves the voice model zip to /sdcard/AstOs/ for AstShell -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <!-- Platform-signed inside the ROM: marks the device provisioned,
         stores the user's AstOs choices where AstShell can read them. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"/>
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>
    <!-- v3.1: the PC companion channel (AstLink) — Bluetooth SPP + USB */
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED"/>

    <application
        android:label="@string/app_name"
        android:theme="@style/AstSetupTheme"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <!-- The clean, custom AstOs first-boot experience. No launcher
             category — it opens on first boot and from AstShell's SETUP
             page ("RUN SETUP WIZARD"). -->
        <activity
            android:name=".SetupActivity"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:immersive="true"
            android:screenOrientation="landscape"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
