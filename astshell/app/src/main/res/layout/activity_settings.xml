<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AstOs Settings"
            android:textSize="24sp"
            android:textColor="@color/ink"/>

        <TextView
            style="@style/SettingsLabel"
            android:text="AI (GROQ)"/>

        <EditText
            android:id="@+id/groqKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Groq API key (console.groq.com/keys)"
            android:inputType="textPassword"
            android:textSize="15sp"/>

        <EditText
            android:id="@+id/groqModelInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Model (default llama-3.1-8b-instant)"
            android:inputType="text"
            android:textSize="15sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/groqSaveBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_primary"
                android:textColor="@color/cream"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="Test &amp; save"/>

            <TextView
                android:id="@+id/groqStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="@color/ink_soft"
                android:layout_marginLeft="12dp"
                android:text=""/>
        </LinearLayout>

        <TextView
            style="@style/SettingsLabel"
            android:text="MUSIC (SPOTIFY FREE)"/>

        <TextView
            android:id="@+id/spotifyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/ink"
            android:text="Checking Spotify…"/>

        <EditText
            android:id="@+id/spotifyIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Spotify client ID (developer dashboard)"
            android:inputType="text"
            android:textSize="15sp"/>

        <EditText
            android:id="@+id/spotifySecretInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Spotify client secret"
            android:inputType="textPassword"
            android:textSize="15sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/spotifySaveBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_primary"
                android:textColor="@color/cream"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="Save keys"/>

            <Button
                android:id="@+id/spotifyInstallBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_chip"
                android:textColor="@color/ink"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Install Spotify"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/ink_faint"
            android:layout_marginTop="6dp"
            android:text="Keys optional: with them, voice instantly plays the exact song; without them, voice opens Spotify search with the song on top."/>

        <TextView
            style="@style/SettingsLabel"
            android:text="HOME ASSISTANT"/>

        <EditText
            android:id="@+id/haUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://homeassistant.local:8123"
            android:inputType="textUri"
            android:textSize="15sp"/>

        <EditText
            android:id="@+id/haTokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Long-lived access token (Profile → Security)"
            android:inputType="textPassword"
            android:textSize="15sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/haTestBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_primary"
                android:textColor="@color/cream"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="Test &amp; load"/>

            <TextView
                android:id="@+id/haStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="@color/ink_soft"
                android:layout_marginLeft="12dp"
                android:text=""/>
        </LinearLayout>

        <TextView
            style="@style/SettingsLabel"
            android:text="WEATHER"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/cityInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Your city"
                android:inputType="textCapWords"
                android:textSize="15sp"/>

            <Button
                android:id="@+id/saveCityBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_btn_primary"
                android:textColor="@color/cream"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="Save"/>
        </LinearLayout>

        <TextView
            style="@style/SettingsLabel"
            android:text="BEHAVIOUR"/>

        <Switch
            android:id="@+id/kioskSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Fullscreen dashboard (kiosk)"/>

        <Switch
            android:id="@+id/keepScreenSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Keep screen on"/>

        <Switch
            android:id="@+id/speakSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Spoken replies (needs a TTS engine)"/>

        <Switch
            android:id="@+id/bootSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Open dashboard on boot"/>

        <TextView
            style="@style/SettingsLabel"
            android:text="SYSTEM"/>

        <Button
            android:id="@+id/notifAccessBtn"
            style="@style/SystemBtn"
            android:text="Enable media control (notification access)"/>

        <Button
            android:id="@+id/homeChooserBtn"
            style="@style/SystemBtn"
            android:text="Choose default home app"/>

        <Button
            android:id="@+id/androidSettingsBtn"
            style="@style/SystemBtn"
            android:text="Advanced system settings"/>

        <TextView
            android:id="@+id/aboutText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/ink_faint"
            android:layout_marginTop="18dp"
            android:text=""/>
    </LinearLayout>
</ScrollView>
